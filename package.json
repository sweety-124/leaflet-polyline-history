{
  "name": "leaflet-polyline-history",
  "version": "0.1.0",
  "description": "Undo and redo history for Leaflet polylines and polygons.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/leaflet-polyline-history.cjs",
  "module": "./dist/leaflet-polyline-history.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/leaflet-polyline-history.js",
      "require": "./dist/leaflet-polyline-history.cjs"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "keywords": [
    "leaflet",
    "polyline",
    "polygon",
    "undo",
    "redo",
    "history"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "npm run build",
    "dev": "vite build --watch",
    "demo:vanilla": "vite --config examples/vanilla-leaflet/vite.config.ts",
    "demo:react": "vite --config examples/react-leaflet/vite.config.ts",
    "build:examples": "vite build --config examples/vanilla-leaflet/vite.config.ts && vite build --config examples/react-leaflet/vite.config.ts",
    "test": "vitest run",
    "lint": "eslint src tests examples",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json"
  },
  "peerDependencies": {
    "@types/leaflet": "^1.9.0",
    "leaflet": "^1.9.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^10.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.11"
  }
}
